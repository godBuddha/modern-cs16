# =================================================================
# Modern CS 1.6 Server — Environment Variables
# Copy: cp .env.example .env  và chỉnh các giá trị bên dưới
# =================================================================

# Database
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=cs16_modern
POSTGRES_USER=cs16admin
DB_CONNECTION=Host=postgres-db;Database=cs16_modern;Username=cs16admin;Password=changeme_secure_password

# JWT (phải dài và ngẫu nhiên!)
JWT_SECRET=change_this_to_a_very_long_random_secret_key_minimum_32_chars

# Game Server
RCON_PASSWORD=rcon_secure_password
SERVER_NAME=Modern CS 1.6 Vietnam
START_MAP=de_dust2
MAX_PLAYERS=32

# API
API_PORT=7000
API_URL=http://localhost:7000

# Dashboard
DASHBOARD_PORT=7001

# VietQR (lấy từ ngân hàng của bạn)
BANK_CODE=970436
BANK_ACCOUNT=0000000000
