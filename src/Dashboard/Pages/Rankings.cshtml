@page
@model Dashboard.Pages.RankingsModel
@{
    ViewData["Title"] = "Bảng Xếp Hạng";
    ViewData["ActivePage"] = "Rankings";
}
<meta http-equiv="refresh" content="30">

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0"><i class="bi bi-trophy-fill me-2 text-warning"></i>Bảng Xếp Hạng ELO</h4>
    <small class="text-muted"><i class="bi bi-arrow-repeat me-1"></i>Auto-refresh mỗi 30s &bull; @DateTime.Now.ToString("HH:mm:ss")</small>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:60px">#</th>
                    <th>Tên</th>
                    <th>ELO</th>
                    <th>Kills</th>
                    <th>Deaths</th>
                    <th>K/D</th>
                    <th>Headshots</th>
                    <th>Wins</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var (p, i) in Model.Players.Select((x, i) => (x, i)))
            {
                var rank = i + 1;
                var kd = p.Deaths > 0 ? Math.Round((double)p.Kills / p.Deaths, 2) : (double)p.Kills;
                var rowClass = rank == 1 ? "table-warning" : rank == 2 ? "table-secondary" : rank == 3 ? "table-danger" : "";
                <tr class="@rowClass">
                    <td class="fw-bold">
                        @if (rank == 1) { <span>🥇</span> }
                        else if (rank == 2) { <span>🥈</span> }
                        else if (rank == 3) { <span>🥉</span> }
                        else { <span class="text-muted">@rank</span> }
                    </td>
                    <td class="fw-semibold">@p.DisplayName</td>
                    <td class="text-warning fw-bold">@p.EloScore.ToString("F0")</td>
                    <td>@p.Kills</td>
                    <td>@p.Deaths</td>
                    <td class="@(kd >= 1.5 ? "text-success" : kd < 1.0 ? "text-danger" : "")">@kd</td>
                    <td>@p.Headshots</td>
                    <td>@p.Wins</td>
                </tr>
            }
            @if (!Model.Players.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">Chưa có dữ liệu xếp hạng</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted small">
        Hiển thị Top @Model.Players.Count players &bull; Tổng: @Model.TotalPlayers players
    </div>
</div>
