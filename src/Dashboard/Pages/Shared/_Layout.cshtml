<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CS 1.6 Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body { background: #0d0d0d; color: #e0e0e0; font-family: 'Segoe UI', sans-serif; }
        .sidebar { width: 240px; min-height: 100vh; background: #141414; border-right: 1px solid #2a2a2a; position: fixed; top: 0; left: 0; z-index: 100; }
        .sidebar-brand { padding: 1.2rem 1.5rem; border-bottom: 1px solid #2a2a2a; }
        .sidebar-brand h5 { color: #ff6b00; font-weight: 700; margin: 0; }
        .nav-link { color: #aaa; padding: .6rem 1.5rem; border-radius: 0; transition: all .2s; }
        .nav-link:hover, .nav-link.active { color: #ff6b00; background: rgba(255,107,0,.08); border-left: 3px solid #ff6b00; }
        .nav-link i { margin-right: .6rem; width: 18px; }
        .main-content { margin-left: 240px; padding: 1.5rem; }
        .card { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 12px; }
        .card-header { background: #1f1f1f; border-bottom: 1px solid #2a2a2a; color: #e0e0e0; }
        .table { color: #e0e0e0; }
        .table thead th { border-color: #2a2a2a; color: #ff6b00; font-size: .8rem; text-transform: uppercase; letter-spacing: .5px; }
        .table tbody tr { border-color: #2a2a2a; }
        .table tbody tr:hover { background: rgba(255,107,0,.05); }
        .badge-rank1 { background: linear-gradient(135deg, #ffd700, #ff8c00); color: #000; }
        .badge-rank2 { background: linear-gradient(135deg, #c0c0c0, #808080); color: #000; }
        .badge-rank3 { background: linear-gradient(135deg, #cd7f32, #8b4513); color: #fff; }
        .stat-card { background: linear-gradient(135deg, #1a1a1a, #222); border: 1px solid #2a2a2a; border-radius: 12px; padding: 1.2rem; }
        .stat-number { font-size: 2rem; font-weight: 700; color: #ff6b00; }
        .btn-primary { background: #ff6b00; border: none; }
        .btn-primary:hover { background: #e55f00; }
        .terminal { background: #0a0a0a; color: #00ff41; font-family: 'Courier New', monospace; border-radius: 8px; padding: 1rem; min-height: 300px; overflow-y: auto; border: 1px solid #1a3a1a; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <h5><i class="bi bi-crosshair2"></i> CS 1.6 Admin</h5>
            <small class="text-muted">Modern Server Dashboard</small>
        </div>
        <nav class="nav flex-column mt-2">
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Index" ? "active" : "")" href="/">
                <i class="bi bi-speedometer2"></i> Tổng quan
            </a>
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Players" ? "active" : "")" href="/Players">
                <i class="bi bi-people-fill"></i> Players
            </a>
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Rankings" ? "active" : "")" href="/Rankings">
                <i class="bi bi-trophy-fill"></i> Rankings
            </a>
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Tournaments" ? "active" : "")" href="/Tournaments">
                <i class="bi bi-award-fill"></i> Giải đấu
            </a>
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Donations" ? "active" : "")" href="/Donations">
                <i class="bi bi-cash-coin"></i> Donate
            </a>
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Kyc" ? "active" : "")" href="/Kyc">
                <i class="bi bi-person-vcard-fill"></i> KYC Queue
            </a>
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Server" ? "active" : "")" href="/Server">
                <i class="bi bi-terminal-fill"></i> Server Console
            </a>
            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Servers" ? "active" : "")" href="/Servers">
                <i class="bi bi-hdd-network-fill"></i> Máy Chủ
            </a>
        </nav>
    </div>
    <div class="main-content">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
